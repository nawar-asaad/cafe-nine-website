# انسخ هذا الملف إلى .env وعدّل القيم.

PORT=3000
# العنوان العام للخادم (يجب أن يكون https حتى تعمل تحديثات بطاقات آبل)
PUBLIC_URL=https://loyalty.example.com
# كلمة مرور لوحة الإدارة (اسم المستخدم: admin)
ADMIN_PASSWORD=change-me

# موقع المطعم (من خرائط Google: اضغط مطولاً على المطعم وانسخ الإحداثيات)
RESTAURANT_LAT=30.5085
RESTAURANT_LNG=47.7804

# ---------- Apple Wallet ----------
# من حساب Apple Developer: Identifiers > Pass Type IDs
APPLE_PASS_TYPE_ID=pass.com.example.zoruna
APPLE_TEAM_ID=ABCDE12345
# الشهادات بصيغة PEM (راجع README لطريقة استخراجها)
APPLE_SIGNER_CERT=certs/signerCert.pem
APPLE_SIGNER_KEY=certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=certs/wwdr.pem

# ---------- Google Wallet ----------
# من Google Pay & Wallet Console
GOOGLE_ISSUER_ID=3388000000000000000
# ملف مفتاح حساب الخدمة (Service Account) بصيغة JSON
GOOGLE_SERVICE_ACCOUNT_FILE=certs/google-service-account.json

# ---------- الرسائل النصية SMS ----------
# console = تُطبع في السجل فقط (للتجربة) | twilio | http
SMS_PROVIDER=console
SMS_SENDER=Zoruna
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# لبوابات SMS المحلية (مثل بوابات شركات الاتصال العراقية): رابط فيه {to} و {text}
SMS_HTTP_URL=https://sms-gateway.example/send?user=X&pass=Y&to={to}&text={text}
